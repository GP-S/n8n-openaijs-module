{
  "name": "n8n-nodes-unsafe-code",
  "version": "1.0.0",
  "description": "An n8n community node that clones the Code node without sandbox restrictions.",
  "author": "",
  "license": "MIT",
  "main": "dist/nodes/UnsafeCode.node.js",
  "types": "dist/nodes/UnsafeCode.node.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/nodes && cp nodes/code.svg dist/nodes/code.svg && cp nodes/*.node.json dist/nodes/",
    "prepare": "npm run build && npm run patch:ui",
    "patch:ui": "node scripts/enable-inline-editor.js",
    "test": "npm run build && node test/test-script.js"
  },
  "dependencies": {
    "@types/node": "^18.19.42",
    "n8n-core": "^1.97.0",
    "n8n-workflow": "^1.97.0",
    "typescript": "^5.2.2"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "n8n": {
    "nodes": [
      "dist/nodes/UnsafeCode.node.js"
    ],
    "credentials": [
      "dist/credentials/UnsafeCodeApi.credentials.js"
    ]
  }
}